# This file is managed by makeOutOfStoreSymlink and is thus writable
# This is mainly a hack to allow devpod to write its Host configuration to the ~/.ssh/config file

AddKeysToAgent yes

Host *
  IdentityFile ~/.ssh/yubikey.pub

Host arntanguy.fr
  User ubuntu
  # Force SSH to use the agent and ignore the file system
  IdentitiesOnly yes
  # Syncthing port forwarding
  # On the arntanguy.fr server syncthing gui is bound to 127.0.0.1:8384
  # We bind the local port 8384 to it through ssh-forwarding
  # Do not expose port 8384 on the server
  LocalForward 8384 127.0.0.1:8384
  IdentityFile ~/.ssh/yubikey.pub
  ForwardAgent yes

Host rhps1
  User rhps1user

Host ar-rob-xmg.local
  User rolkneematics

Host jumpbox
  Hostname jumpbox.lirmm.fr
  User atanguy
  IdentityFile ~/.ssh/yubikey.pub

Host puma
  Hostname puma.lirmm.fr
  User atanguy
  ProxyJump jumpbox
  IdentityFile ~/.ssh/yubikey.pub

Host ardell.lirmm.fr
  Hostname 193.49.106.89
  User arnaud
  ProxyJump jumpbox
  IdentityFile ~/.ssh/yubikey.pub
  ForwardAgent yes

